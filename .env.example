# Project Zia / FAITH Configuration
# Add your Gemini API Key below
GEMINI_API_KEY=your_gemini_api_key_here

# Engine & Bridge Network Settings
HOST=127.0.0.1
HTTP_PORT=8080
WS_PORT=8765

# Model Settings
MODEL_NAME=TianYeLulu
MODEL_PATH=/assets/models/TianYeLulu/TianYeLulu.model3.json

# Live2D Audio Lip-Sync Sensitivity (0.1 to 2.0)
LIP_SYNC_SENSITIVITY=1.2

# Proactive Interaction Interval in Seconds (0 to disable)
PROACTIVE_IDLE_SECONDS=45


# Local IoT Bridge Settings (Tasmota, WLED, Shelly, Generic)
IOT_DEVICE_IP=192.168.1.50
IOT_DEVICE_TYPE=tasmota
